# ============================================================
# Plantilla de Variables de Entorno - SENA Feria Proyectos Productivos
# Copiar este archivo a .env y modificar los valores según corresponda
# ============================================================

# ------------------------------------------------------------
# CONFIGURACIÓN BÁSICA DE DJANGO
# ------------------------------------------------------------

# Clave secreta de Django - CAMBIAR ESTE VALOR POR UNA CADENA ALEATORIA SEGURA
# Generar una clave con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cambiar_esto_por_una_clave_secreta_segura

# Modo depuración (True = desarrollo, False = producción)
DJANGO_DEBUG=True

# Hosts permitidos (separados por coma, sin espacios)
# En producción agregar el dominio del sitio, ej: mi-sitio.pythonanywhere.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes confiables para CSRF (separados por coma)
# Incluir URL completa con protocolo (http/https) y puerto si aplica
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# ------------------------------------------------------------
# CONFIGURACIÓN DE IDIOMA Y ZONA HORARIA
# ------------------------------------------------------------

# Código de idioma (español colombiano)
DJANGO_LANGUAGE_CODE=es-CO

# Zona horaria (Hora estándar de Colombia)
DJANGO_TIME_ZONE=America/Bogota

# ------------------------------------------------------------
# CONFIGURACIÓN DE ARCHIVOS ESTÁTICOS Y MEDIOS
# ------------------------------------------------------------

# URL base para servir archivos estáticos (CSS, JS, imágenes del sistema)
DJANGO_STATIC_URL=/static/

# URL base para servir archivos de medios (subidos por usuarios: fotos, documentos)
DJANGO_MEDIA_URL=/media/

# ------------------------------------------------------------
# SEGURIDAD - PANEL ADMINISTRATIVO
# ------------------------------------------------------------

# URL personalizada del panel de administración Django
# Cambiar para evitar accesos no autorizados por rutas comunes
DJANGO_ADMIN_URL=admin-seguro-sena-2026/

# ------------------------------------------------------------
# CONFIGURACIÓN DE BASE DE DATOS (OPCIONAL)
# ------------------------------------------------------------
# Si desea usar PostgreSQL o MySQL en lugar de SQLite,
# descomente y configure las siguientes variables:

# DJANGO_DB_ENGINE=django.db.backends.postgresql
# DJANGO_DB_NAME=nombre_base_datos
# DJANGO_DB_USER=usuario_db
# DJANGO_DB_PASSWORD=contrasena_db
# DJANGO_DB_HOST=localhost
# DJANGO_DB_PORT=5432

# ------------------------------------------------------------
# TOKENS PÚBLICOS (enlaces que NO piden usuario ni contraseña)
# ------------------------------------------------------------
# Compártelos con quien necesites:
#   · Registro de proyectos:        {BASE_URL}/r/{TOKEN_REGISTRO}/registro/
#   · Operador asistencia:          {BASE_URL}/o/{TOKEN_OPERADORES}/asistencia/
#   · Operador refrigerios:         {BASE_URL}/o/{TOKEN_OPERADORES}/refrigerios/
#   · Operador certificados:        {BASE_URL}/o/{TOKEN_OPERADORES}/certificados/
# Si la variable está VACÍA se desactiva el acceso público y PIDE LOGIN (seguro).
#
# Generar tokens seguros:
#   python -c "import secrets; print(secrets.token_urlsafe(18))"
#
TOKEN_REGISTRO=feria-sena-registro-2026-facil-decidir
TOKEN_OPERADORES=feria-sena-operadores-2026-operar-rapido

# ------------------------------------------------------------
# CONFIGURACIÓN DE PROYECTOS / FERIA
# ------------------------------------------------------------
# Máximo número de aprendices permitidos POR PROYECTO (cada ficha)
# El administrador puede cambiar este valor. Default: 3 (rango 1-99)
MAX_APRENDICES_POR_PROYECTO=3
